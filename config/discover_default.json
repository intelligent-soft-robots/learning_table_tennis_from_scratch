    "adapt_achievability": true,
    "target_achievement_rate": 0.5,
    "adaptation_deadband": 0.2,
    "adaptation_rate": 100,
    "achievement_window": 20,
    "achievement_eps": 0.7,
    "achievement_eps_log": [0.3, 0.5, 0.7, 1.0, 1.3],
